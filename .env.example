# 本仓库为 pnpm workspace monorepo,各包的环境变量在各自目录内配置。
#
# 后端(NestJS)配置见: packages/backend/.env.example
#   cp packages/backend/.env.example packages/backend/.env
#   按注释填写 DATABASE_URL / JWT_SECRET / JWT_REFRESH_SECRET / APP_ENCRYPTION_KEY 等
#
# 前端 web(Vite)如需环境变量,放 packages/web/.env(以 VITE_ 前缀)。
# 小程序 miniapp 的运行时配置见 packages/miniapp/config/。
#
# 根目录本身不读取任何 .env,此文件仅作指引。
# 本地分布式运行时测试由 docker-compose.dev.yml 提供 Redis: redis://127.0.0.1:56379。

#
# Web 生产构建必填:公开落地页“申请开通”联系方式。
VITE_PUBLIC_SALES_CONTACT="sales@example.com / 400-000-0000"
# 小程序生产构建必填:HTTPS API、微信 AppID 和用户可见客服联系方式。
TARO_APP_API="https://api.example.com/api"
TARO_APP_WX_APPID="wx0000000000000000"
TARO_APP_SUPPORT_CONTACT="support@example.com / 400-000-0000"
