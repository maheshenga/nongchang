{
  "name": "nongchang",
  "private": true,
  "scripts": {
    "build:shared": "pnpm --filter @nongchang/shared build",
    "build:backend": "pnpm --filter @nongchang/backend build",
    "build": "pnpm build:shared && pnpm build:backend",
    "build:miniapp": "pnpm --filter @nongchang/miniapp build:weapp",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build:shared && pnpm --filter @nongchang/backend test:unit && pnpm --filter web test && pnpm --filter @nongchang/miniapp test",
    "test:e2e": "pnpm build:shared && pnpm --filter @nongchang/backend test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.1"
  }
}
