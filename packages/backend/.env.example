DATABASE_URL=""
# Prisma 经 PgBouncer(transaction pooling)时追加:
# ?schema=public&pgbouncer=true&connection_limit=20&pool_timeout=10
DATABASE_POOL_MAX=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# JWT 密钥:生产环境必须为 >=32 位强随机值(openssl rand -hex 32),不可用占位/弱值,否则启动报错。
JWT_SECRET=""
JWT_REFRESH_SECRET=""
WX_APPID=""
WX_SECRET=""

# 服务监听端口,默认 3001。
PORT=3001

# 阿里云 OSS(图片上传,生产在宝塔 .env 填真实值,勿提交真实凭据)
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BASE_URL=

# 32 字节加密主密钥(hex 64 位或 base64)。用于加密 AI/OSS 凭据。缺失则启动报错。
APP_ENCRYPTION_KEY=

# 可信反向代理跳数:从 X-Forwarded-For 右端回溯取可信客户端真实 IP(防伪扫码去重/多地检测)。
# 宝塔单层 Nginx 反代填 1;Node 直接对外(无反代)填 0;CDN+Nginx 等多层按实际层数填。
# 默认 1。配错(填太大)会被客户端伪造 XFF 绕过,故须与实际部署拓扑一致。
TRUST_PROXY_HOPS=1

# 分布式运行时状态。生产必须使用 redis；本地纯单元测试可设 memory。
RUNTIME_STATE_DRIVER=redis
REDIS_URL=redis://127.0.0.1:56379
# 同一队列允许多实例 worker；仅在承担后台任务的进程上开启。
OPERATIONS_WORKERS_ENABLED=false
OPERATIONS_WORKER_CONCURRENCY=2

# 可观测性：未配置 OTLP 端点时不会启动 trace exporter，也不会向外发送数据。
OTEL_SERVICE_NAME=nongchang-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# 指标端点为 /api/metrics。生产环境应通过内网/反向代理阻断公网访问，或配置至少 24 字符的 Bearer token。
METRICS_BEARER_TOKEN=

# 由不可变发布清单注入的完整 40 位 Git SHA；/api/health/live 会回报该值供流量切换前核验。
DEPLOYED_GIT_SHA=

# 上传配额（字节）：按租户统计 UTC 自然日流量与当前存量；均须为正安全整数。
UPLOAD_DAILY_BYTES_LIMIT=104857600
UPLOAD_ACTIVE_BYTES_LIMIT=5368709120
# PENDING 上传超过该分钟数后可由 cleanup 命令检查/清理。
UPLOAD_PENDING_MAX_AGE_MINUTES=60

# ── 支付宝支付 ──
# 后端公网地址(支付宝异步回调 notify_url 基址),必须公网可达,形如 https://api.example.com。未配置则发起支付报错。
PUBLIC_BASE_URL=
# 就绪面板只检查以下公开联系方式是否存在，不回显实际值；应与 Web/小程序生产构建值保持一致。
PUBLIC_SUPPORT_CONTACT=
PUBLIC_SALES_CONTACT=
# 前端站点地址(支付完成同步回跳 return_url 基址),形如 https://web.example.com。
WEB_BASE_URL=
# 支付宝网关,默认正式环境 https://openapi.alipay.com/gateway.do;沙箱环境填沙箱网关。
ALIPAY_GATEWAY=
# 免支付兜底入账开关(/billing/orders/:id/pay):置 true 才允许跳过真实支付直接到账。
# 默认关闭。生产务必留空/false 以杜绝绕过支付直接入账;仅本地联调(小程序暂无真实支付)时置 true。
ALLOW_MANUAL_PAY=false
