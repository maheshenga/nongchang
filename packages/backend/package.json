{
  "name": "@nongchang/backend",
  "version": "0.0.0",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "test": "prisma generate && vitest run",
    "test:unit": "prisma generate && vitest run",
    "test:e2e": "prisma generate && tsx test/check-e2e-db.ts && vitest run -c vitest.e2e.config.ts",
    "e2e:check-db": "tsx test/check-e2e-db.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx scripts/run-demo-seed.ts",
    "billing:recover-reservations": "tsx scripts/recover-stale-reservations.ts",
    "upload:cleanup": "tsx scripts/cleanup-stale-uploads.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@nongchang/shared": "workspace:*",
    "@prisma/client": "^5.18.0",
    "ali-oss": "^6.23.0",
    "alipay-sdk": "3.6.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "nestjs-cls": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@swc/core": "^1.7.0",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.0.5"
  }
}
